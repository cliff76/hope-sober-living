# Copy this file to .env.local for local development
# cp .env.example .env.local

############################################################
# Clerk (Authentication)
############################################################
# Server-only secret key from Clerk dashboard
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Public key for client-side SDK initialization
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Optional routes for custom sign-in/up flows
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

############################################################
# Database (Postgres)
############################################################
# EITHER provide a full connection string:
# Example for Vercel/Neon/Render/etc.
DATABASE_URL=postgres://user:password@hostname:5432/dbname?sslmode=require

# OR provide the individual parts below and the app will construct DATABASE_URL:
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOSTNAME=localhost
DB_PORT=5432
DB_NAME=hope
# Set to "true" to disable SSL (e.g., local Docker Postgres). Defaults to requiring SSL.
DB_DISABLE_SSL=true
